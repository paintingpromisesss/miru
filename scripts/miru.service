[Unit]
Description=Miru - Mihomo Rule Manager
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/miru/miru.env
ExecStart=/usr/bin/miru \
    -config ${MIRU_CONFIG:-/etc/mihomo/config.yaml} \
    -rules-dir ${MIRU_RULES_DIR:-/etc/mihomo/rules} \
    -port ${MIRU_PORT:-8080} \
    -mihomo-api ${MIRU_MIHOMO_API:-http://127.0.0.1:9090} \
    -mihomo-secret ${MIRU_MIHOMO_SECRET:-} \
    -github-token ${MIRU_GITHUB_TOKEN:-} \
    -github-proxy ${MIRU_GITHUB_PROXY:-auto}
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
