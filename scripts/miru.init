#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/miru
CONF=/etc/miru/miru.env

start_service() {
    local config="/etc/mihomo/config.yaml"
    local rules_dir="/etc/mihomo/rules"
    local port="8080"
    local mihomo_api="http://127.0.0.1:9090"
    local mihomo_secret=""
    local github_token=""

    if [ -f "$CONF" ]; then
        . "$CONF"
        [ -n "$MIRU_CONFIG" ] && config="$MIRU_CONFIG"
        [ -n "$MIRU_RULES_DIR" ] && rules_dir="$MIRU_RULES_DIR"
        [ -n "$MIRU_PORT" ] && port="$MIRU_PORT"
        [ -n "$MIRU_MIHOMO_API" ] && mihomo_api="$MIRU_MIHOMO_API"
        [ -n "$MIRU_MIHOMO_SECRET" ] && mihomo_secret="$MIRU_MIHOMO_SECRET"
        [ -n "$MIRU_GITHUB_TOKEN" ] && github_token="$MIRU_GITHUB_TOKEN"
    fi

    procd_open_instance
    procd_set_param command "$PROG" \
        -config "$config" \
        -rules-dir "$rules_dir" \
        -port "$port" \
        -mihomo-api "$mihomo_api"

    [ -n "$mihomo_secret" ] && procd_append_param command -mihomo-secret "$mihomo_secret"
    [ -n "$github_token" ] && procd_append_param command -github-token "$github_token"

    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall miru 2>/dev/null || true
}
