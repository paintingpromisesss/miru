#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c 'set -a; . /etc/miru/miru.env; if [ "$MIRU_MODE" = nikki ] && [ -z "$MIRU_MIHOMO_SECRET" ]; then MIRU_MIHOMO_SECRET="$(uci -q get nikki.mixin.api_secret || true)"; fi; set +a; exec /usr/bin/miru'
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
